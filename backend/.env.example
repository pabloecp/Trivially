# ==========================================
# TRIVIALLY - Variables de Entorno Backend
# ==========================================

# Puerto del servidor backend en local
PORT=8080

# Origen permitido del cliente frontend
# Para desarrollo local con Vite:
CLIENT_ORIGIN=http://localhost:5173
# Para producción en Vercel:
# CLIENT_ORIGIN=https://triviallyonline.vercel.app

# Secreto para firmar cookies de sesión
SESSION_SECRET=yoavlly-dev-secret-key-trivially

# ------------------------------------------
# Google OAuth (Opcional - para inicio de sesión con Google)
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URI de redireccionamiento de Google:
# Para desarrollo local (debe coincidir con la consola de Google Cloud):
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Para producción:
# GOOGLE_REDIRECT_URI=https://triviallyonline.vercel.app/auth/google/callback

# ------------------------------------------
# Supabase (base de datos). Si no se definen, se usa data/store.json.
# Project Settings -> API: "Project URL" y la clave "service_role" (secreta, solo en el backend).
# ------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
