# ==========================================
# TRIVIALLY - Variables de Entorno
# ==========================================

# Puerto del servidor backend (Railway usa 8080)
PORT=8080

# Origen permitido del cliente frontend en Vercel (CORS y redirecciones)
CLIENT_ORIGIN=https://triviallyonline.vercel.app

# Secreto para firmar cookies de sesión
SESSION_SECRET=yoavlly-production-secret-key-trivially

# ------------------------------------------
# Google OAuth (Opcional - para inicio de sesión con Google)
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://triviallyonline.vercel.app/auth/google/callback
